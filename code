assertions
def assertions(text):
    result=[]
    # Contrast words split scope even when punctuation is omitted.
    for match in re.finditer(r'[^，。；,;！？!?]+',text):
        clause=match.group(); base=match.start()
        for sub in re.finditer(r'(?:但是|但|不过|然而|随后|现在)?[^但]+',clause):
            segment=sub.group(); offset=base+sub.start()
            for category,terms in RISK_LEXICON.items():
                for term in terms:
                    for hit in re.finditer(re.escape(term),segment):
                        prefix=segment[max(0,hit.start()-12):hit.start()]
                        state='uncertain' if UNCERTAIN.search(prefix) else 'negative' if NEGATIVE.search(prefix) else 'positive'
                        suffix=segment[hit.end():hit.end()+7]
                        if re.match(r'(?:情况)?(?:已排除|不存在|已否认)',suffix): state='negative'
                        historical=bool(PAST.search(prefix))
                        start=offset+hit.start(); end=offset+hit.end()
                        result.append(dict(category=category,term=term,state=state,historical=historical,
                                           start=start,end=end,quote=text[base:match.end()],scope=segment))
    return sorted(result,key=lambda r:(r['start'],r['category']))
