    s=re.sub(r'([零一二两三四五六七八九十百千\d]+)(号|栋|幢|楼|层|室)',lambda m:number_cn(m[1])+m[2],s)
    patterns={'road':r'([\u4e00-\u9fff]{2,12}(?:路|街|大道|巷))', 'number':r'(\d+)号',
              'building':r'(\d+)(?:栋|幢)', 'floor':r'(\d+)(?:层|楼)', 'room':r'(\d+)室',
              'gate':r'([东西南北](?:[东西南北])?)门','poi':r'([\u4e00-\u9fff]{2,12}(?:小区|商场|公园|广场|学校|大厦|医院))'}
