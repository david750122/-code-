    def analyze(self, query):
        candidates = []
        for i in self.retrieve(query):
            r = self.records[i]
            x = features(query, r)
            parts = [w*v for w,v in zip(self.weights[1:], x)]
            p = sigmoid(self.weights[0]+sum(parts))
            candidates.append({'candidate': r, 'score': p, 'features': dict(zip(FEATURES,x)),
                               'contributions': dict(zip(FEATURES,parts)), 'risk_flags': sorted(risks(query['text'])-risks(r['text'])),
                               'alarm_evidence':describe_pair(query,r)})
        candidates.sort(key=lambda c: (-c['score'], c['candidate']['id']))
        if not candidates:
            danger = sorted(risks(query['text']))
            return {'candidate': None, 'score': 0., 'decision':'人工复核' if danger else '独立警情', 'tone':'review' if danger else 'independent', 'risk_flags': danger, 'reasons':['未召回候选，仍须正常受理'], 'candidates': [],
                    'alarm_evidence':{'new_assertions':assertions(query['text']),'matches':[],'differences':[],'pending':['补充现场位置与发生时间'],'changes':[]}}
        top = candidates[0]
        reasons = []
        f = top['features']
        if risks(query['text']): reasons.append('存在风险线索')
        if f['address_conflict']: reasons.append('门牌楼层或出入口冲突')
        if f['negation_conflict']: reasons.append('否定或风险表述冲突')
        if not timestamp(query.get('occurred_at')): reasons.append('时间缺失或无效')
        if len(candidates)>1 and top['score']-candidates[1]['score'] < .08: reasons.append('多个候选得分接近')
        prediction_set = self.calibration.predict(top['score']) if self.calibration else [0,1]
        if self.calibration is None: reasons.append('关联依据仍需人工核实')
        elif len(prediction_set) != 1: reasons.append('现有信息不能形成唯一关联建议')
        if reasons:
            decision, tone = '人工复核', 'review'
        elif prediction_set == [1] and top['score']>=.78:
            decision, tone = '高概率关联', 'likely'
        elif prediction_set == [0] and top['score']<.38:
            decision, tone = '独立警情', 'independent'
        else:
            decision, tone = '人工复核', 'review'
        return {**top, 'decision':decision, 'tone':tone, 'reasons':reasons, 'prediction_set':prediction_set,
                'risk_flags':sorted(risks(query['text'])), 'new_risk_flags':top['risk_flags'],
                'calibrated':self.calibration is not None, 'candidates':candidates, 'version':VERSION}
