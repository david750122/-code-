def fit_logistic(rows, epochs=800, lr=.1, l2=.01):
    """Explicit offline training only. rows = [(feature_vector, binary_label)]."""
    if len(rows)<2 or set(y for _,y in rows)!={0,1}:
        raise ValueError('training needs both classes')
    if any(len(x)!=len(FEATURES) or any(not math.isfinite(v) or not 0<=v<=1 for v in x) for x,_ in rows):
        raise ValueError('invalid feature vector')
    w = [0.]*(len(FEATURES)+1)
    for _ in range(epochs):
        g = [0.]*len(w)
        for x,y in rows:
            v = [1.]+list(x)
            e = sigmoid(sum(a*b for a,b in zip(w,v)))-y
            for j in range(len(w)): g[j] += e*v[j]/len(rows)
        w = [a-lr*(b+(l2*a if j else 0)) for j,(a,b) in enumerate(zip(w,g))]
    return w
