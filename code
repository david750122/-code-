    def retrieve(self, query, k=10):
        scores = defaultdict(float)
        n = len(self.records)
        for term in set(grams(query['text'])):
            posting = self.postings.get(term, ())
            idf = math.log(1+(n-len(posting)+.5)/(len(posting)+.5))
            for i in posting:
                tf, dl = self.terms[i][term], self.lengths[i]
                scores[i] += idf*tf*2.2/(tf+1.2*(.25+.75*dl/self.avgdl))
        lexical = sorted(scores, key=lambda i: (-scores[i], self.records[i]['id']))[:k]
        # Location route protects paraphrases from lexical-only truncation.
        qloc=set(grams(query['location']))
        loc = [(len(qloc & tokens)/len(qloc | tokens) if qloc and tokens else 0., i) for i,tokens in enumerate(self.location_terms)]
        structural = [i for s,i in sorted(loc, key=lambda x: (-x[0], self.records[x[1]]['id']))[:k] if s >= .15]
        fused = defaultdict(float)
        for route in (lexical, structural):
            for rank, i in enumerate(route, 1):
                fused[i] += 1/(60+rank)
        return sorted(fused, key=lambda i: (-fused[i], self.records[i]['id']))[:2*k]
