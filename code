class SplitConformal:
    """Fixed model, disjoint calibration. Marginal coverage requires exchangeability."""
    def __init__(self, scores=(), alpha=.1):
        if not 0 < alpha < 1 or any(not math.isfinite(s) or not 0 <= s <= 1 for s in scores):
            raise ValueError('invalid calibration')
        self.n, self.alpha = len(scores), alpha
        k = math.ceil((self.n+1)*(1-alpha))
        self.q = sorted(scores)[k-1] if 0 < k <= self.n else float('inf')

    def predict(self, p):
        return [y for y in (0, 1) if (p if y == 0 else 1-p) <= self.q]
