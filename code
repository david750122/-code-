def fact_changes(new,old):
    a,b=assertions(new),assertions(old)
    states=lambda rows,cat:{r['state'] for r in rows if r['category']==cat}
    changes=[]
    for cat in RISK_LEXICON:
        aa,bb=states(a,cat),states(b,cat)
        if not aa: continue
        status='新增线索' if not bb and aa-{'negative'} else '否定转为风险线索' if bb=={'negative'} and aa-{'negative'} else '风险表述变化' if aa!=bb and bb else '持续风险线索' if aa-{'negative'} else '本次未见该风险'
        changes.append(dict(category=cat,change=status,new=[r for r in a if r['category']==cat],old=[r for r in b if r['category']==cat]))
    return changes
